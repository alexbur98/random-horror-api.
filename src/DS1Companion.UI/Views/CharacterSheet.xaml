<UserControl x:Class="DS1Companion.UI.Views.CharacterSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS1Companion.Core.Presentation;assembly=DS1Companion.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="SheetChrome.xaml" />
    </UserControl.Resources>
    <Border Style="{StaticResource SheetBorder}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseSheetCommand}" ToolTip="Закрыть (Esc)">
                    <Path Data="{StaticResource Ui.Close}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <StackPanel>
                    <Border Width="40" Height="4" CornerRadius="2" Background="{StaticResource LineBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Caption}" Text="ПЕРСОНАЖ И ХАРАКТЕРИСТИКИ" />
                    <TextBlock Style="{StaticResource SerifTitle}" Margin="0,4,0,0">
                        <Run Text="{Binding CharacterName, Mode=OneWay}" />
                        <Run Text=" · уровень " Foreground="{StaticResource TextMutedBrush}" /><Run Text="{Binding Level, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,10"
                               Text="{Binding StatsSheetHint}" />
                    <ItemsControl ItemsSource="{Binding StatRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatRowViewModel}">
                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TextBase}" FontSize="15" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" FontFamily="{StaticResource NumberFont}" FontSize="20" Text="{Binding Value}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCapped}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Body}" FontSize="12" Text="{Binding Hint}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,22,0,8" Text="{Binding CollectionSummary}" />
                    <ItemsControl ItemsSource="{Binding Collection}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CollectedRowViewModel}">
                                <Border Margin="0,0,8,8" Padding="10,5" CornerRadius="12" BorderThickness="1"
                                        BorderBrush="{Binding RarityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.6}"
                                        ToolTip="{Binding FoundText}">
                                    <TextBlock Style="{StaticResource TextBase}" FontSize="12" Text="{Binding Name}"
                                               Foreground="{Binding RarityColor, Converter={StaticResource HexToBrush}}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,22,0,8" Text="НАСТРОЙКИ КАРТОЧЕК" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource DarkComboBox}" ItemsSource="{Binding RarityOptions}"
                                  SelectedItem="{Binding PopupMinRarity}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource RarityLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                                   Text="Показывать большую карточку для редкости от (ключевые предметы — всегда):" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
