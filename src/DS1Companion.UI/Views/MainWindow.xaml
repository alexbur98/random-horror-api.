<Window x:Class="DS1Companion.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DS1Companion.Core.Presentation;assembly=DS1Companion.Core"
        xmlns:ctl="clr-namespace:DS1Companion.UI.Controls"
        xmlns:views="clr-namespace:DS1Companion.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DS1 Companion"
        Width="760" Height="1200" MinWidth="600" MinHeight="720" MaxWidth="1080"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource ObsidianBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource SansFont}"
        UseLayoutRounding="True"
        Topmost="{Binding IsTopmost}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Фон: обсидиан, зерно, тёплое свечение снизу, искры, виньетка ── -->
        <Rectangle Grid.RowSpan="3" Fill="{StaticResource ObsidianBrush}" />
        <Rectangle x:Name="NoiseLayer" Grid.RowSpan="3" Opacity="0.9" />
        <Rectangle Grid.RowSpan="3" Fill="{StaticResource WarmGlowBrush}" />
        <ctl:EmberField Grid.RowSpan="3" Count="34" IsCalm="{Binding IsCardVisible}" />
        <Rectangle Grid.RowSpan="3" Fill="{StaticResource VignetteBrush}" IsHitTestVisible="False" />

        <!-- ── Кастомная шапка окна ── -->
        <Border Grid.Row="0" Background="#CC07080A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="14,0,6,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Ui.Bonfire}" Fill="{StaticResource GoldBrush}" Width="16" Height="16" Stretch="Uniform" />
                    <TextBlock Margin="10,0,0,0" Text="DS1 COMPANION" FontFamily="{StaticResource SerifFont}" FontSize="13"
                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding IsDemoMode, Mode=OneWay}"
                                  Command="{Binding ToggleDemoCommand}" Margin="0,0,10,0" ToolTip="Демо-режим без запущенной игры">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ui.Play}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Демо-режим" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource IconButton}" IsChecked="{Binding IsTopmost}" ToolTip="Поверх всех окон">
                        <Path Data="{StaticResource Ui.Pin}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Width="14" Height="14" Stretch="Uniform" />
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource IconButton}" IsChecked="{Binding IsMuted}" ToolTip="Звук вкл/выкл (Mute)">
                        <Grid Width="16" Height="16">
                            <Path Data="{StaticResource Ui.Speaker}" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  Visibility="{Binding IsMuted, Converter={StaticResource InvBoolToVis}}" />
                            <Path Data="{StaticResource Ui.Mute}" Stretch="Uniform" Fill="{StaticResource BloodBrush}"
                                  Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </ToggleButton>
                    <Slider Style="{StaticResource VolumeSlider}" Value="{Binding Volume}" Margin="2,0,12,0" ToolTip="Громкость"
                            SmallChange="0.05" LargeChange="0.1" />

                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Свернуть">
                        <Path Data="{StaticResource Ui.Minimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Закрыть">
                        <Path Data="{StaticResource Ui.Close}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Состояние 1: спокойный режим ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Dashboard" Margin="32,20,32,28" MaxWidth="960">

                <!-- Строка статуса -->
                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="26" Height="26" VerticalAlignment="Center">
                        <Path Data="{StaticResource Ui.Bonfire}" Fill="{StaticResource GoldDimBrush}" Stretch="Uniform" />
                        <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Demo">
                                            <Setter Property="Fill" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding ConnectionLabel}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="Demo">
                                            <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Body}" FontSize="12" Text="{Binding CharacterName}"
                                   Visibility="{Binding CharacterName, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource Caption}" Text="СЕССИЯ" HorizontalAlignment="Right" />
                        <TextBlock Style="{StaticResource TextBase}" FontFamily="Consolas" FontSize="18" Text="{Binding SessionTime}"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <!-- Локация -->
                <TextBlock Style="{StaticResource Caption}" Text="ТЕКУЩАЯ ЛОКАЦИЯ" />
                <TextBlock Style="{StaticResource SerifTitle}" FontSize="34" Margin="0,6,0,0" Text="{Binding LocationNameRu}" />
                <TextBlock Style="{StaticResource TextBase}" FontStyle="Italic" FontSize="14" Foreground="{StaticResource GoldDimBrush}"
                           Text="{Binding LocationNameEn}" Margin="0,2,0,24" />

                <!-- Смерти -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Panel}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{StaticResource Ui.Skull}" Fill="{StaticResource TextMutedBrush}"
                                  Width="34" Height="34" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <StackPanel>
                                <TextBlock Style="{StaticResource BigNumber}" Text="{Binding SessionDeaths}" />
                                <TextBlock Style="{StaticResource Caption}" Text="СМЕРТЕЙ ЗА СЕССИЮ" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Panel}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BigNumber}" Foreground="{StaticResource TextMutedBrush}" Text="{Binding TotalDeaths}" />
                            <TextBlock Style="{StaticResource Caption}" Text="ВСЕГО У ПЕРСОНАЖА" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Души -->
                <Border Style="{StaticResource Panel}" Margin="0,0,0,16">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextBase}" FontFamily="{StaticResource NumberFont}"
                                       FontSize="15" Text="{Binding SoulsText}" />
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                                <Run Text="ДУШИ НА РУКАХ / НА СЛЕДУЮЩИЙ УРОВЕНЬ" />
                                <Run Text=" · УР. " /><Run Text="{Binding Level, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <Border Height="6" CornerRadius="3" Background="#1E222B" Margin="0,12,0,8" ClipToBounds="True">
                            <Border CornerRadius="3" Background="{StaticResource SoulsFillBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding SoulsProgress}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock Style="{StaticResource Body}" FontSize="12" Text="{Binding SoulsHint}" />
                    </StackPanel>
                </Border>

                <!-- Контекстные маячки -->
                <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="6" Background="#1FB4383A" BorderBrush="#66B4383A" BorderThickness="1"
                        Visibility="{Binding HasBloodstain, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource Ui.Bloodstain}" Fill="{StaticResource BloodBrush}" Width="22" Height="22"
                              Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Foreground="#E07A7C" Text="КРОВАВОЕ ПЯТНО" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextBrush}" Text="{Binding BloodstainText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="6" Background="#1FE3B341" BorderBrush="#66E3B341" BorderThickness="1"
                        Visibility="{Binding ShowDurabilityWarning, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource Ui.Warning}" Fill="{StaticResource WarnBrush}" Width="22" Height="22"
                              Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource WarnBrush}" Text="ПРОЧНОСТЬ ОРУЖИЯ" />
                            <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextBrush}" Text="{Binding DurabilityWarningText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ── У костра: оружие и совет ── -->
                <Grid Margin="0,18,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0">
                        <Path Data="{StaticResource Ui.Diamond}" Fill="{StaticResource GoldDimBrush}" Width="7" Height="7" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Caption}" Text="У КОСТРА" Margin="10,0" Foreground="{StaticResource GoldBrush}" />
                        <Path Data="{StaticResource Ui.Diamond}" Fill="{StaticResource GoldDimBrush}" Width="7" Height="7" Stretch="Uniform" VerticalAlignment="Center" />
                    </StackPanel>
                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Center" />
                </Grid>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,12" DataContext="{Binding Weapon}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="ОРУЖИЕ В ОСНОВНОЙ РУКЕ" />
                        <TextBlock Style="{StaticResource SerifTitle}" Margin="0,6,0,0" Text="{Binding Title}" />
                        <StackPanel Visibility="{Binding HasWeapon, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource TextBase}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource GoldDimBrush}"
                                       Margin="0,6,0,0" Text="{Binding ScalingLetters}" />
                            <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0" Foreground="{StaticResource TextBrush}" Text="{Binding ScalingHint}" />
                            <DockPanel Margin="0,10,0,0" Visibility="{Binding HasNextStep, Converter={StaticResource BoolToVis}}">
                                <Path DockPanel.Dock="Left" Data="{StaticResource Glyph.Titanite}" Fill="{StaticResource GoldBrush}" Width="14" Height="14"
                                      Stretch="Uniform" Margin="0,3,10,0" VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Body}" Text="{Binding NextStep}" />
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Body}" FontSize="11" Text="{Binding DurabilityText}" Margin="12,0,0,0" />
                                <Border Height="3" CornerRadius="2" Background="#1E222B" VerticalAlignment="Center" ClipToBounds="True">
                                    <Border CornerRadius="2" Background="{StaticResource GoldDimBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding DurabilityFraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Glyph.Scroll}" Fill="{StaticResource GoldDimBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Caption}" Text="СОВЕТ МЫЛЬНОГО КАМНЯ" Margin="8,0,0,0" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Tips}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextBrush}" FontStyle="Italic"
                                               Margin="0,4,0,0" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Недавний лут ── -->
                <TextBlock Style="{StaticResource Caption}" Text="НЕДАВНИЕ НАХОДКИ" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8"
                           Text="Пока пусто. Поднятые предметы появятся здесь — клик откроет карточку."
                           Visibility="{Binding HasRecentLoot, Converter={StaticResource InvBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding RecentLoot}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LootRowViewModel}">
                            <Button Style="{StaticResource RowButton}" Margin="0,0,0,4"
                                    Command="{Binding DataContext.OpenLootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Grid Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Background="{Binding RarityColor, Converter={StaticResource HexToBrush}}" Margin="0,8" />
                                    <ctl:ItemIcon Grid.Column="1" Width="32" Height="32" Margin="14,0" VerticalAlignment="Center"
                                                  Source="{Binding Icon}" GlyphBrush="{Binding RarityColor, Converter={StaticResource HexToBrush}}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextBase}" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding QuantityText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Body}" FontSize="11" TextWrapping="NoWrap">
                                            <Run Text="{Binding RarityLabel, Mode=OneWay}" Foreground="{Binding RarityColor, Converter={StaticResource HexToBrush}}" />
                                            <Run Text=" · " /><Run Text="{Binding CategoryLabel, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Body}" FontSize="12" Margin="12,0,14,0" VerticalAlignment="Center"
                                               Text="{Binding TimeText}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Кнопки окон у костра -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenStatsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ui.Person}" Fill="{StaticResource GoldDimBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Персонаж и статы" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Command="{Binding OpenBossesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Ui.Crown}" Fill="{StaticResource GoldDimBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Статистика по боссам" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Демо-панель (только в демо-режиме) -->
        <views:DemoPanel Grid.Row="2" DataContext="{Binding Demo}"
                         Visibility="{Binding DataContext.IsDemoMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

        <!-- ── Затемнение под карточкой / шторкой ── -->
        <Rectangle x:Name="DimLayer" Grid.Row="1" Grid.RowSpan="2" Fill="{StaticResource DimBrush}"
                   Visibility="{Binding IsSheetOpen, Converter={StaticResource BoolToVis}}"
                   MouseLeftButtonDown="Dim_MouseLeftButtonDown" />
        <Rectangle Grid.Row="1" Grid.RowSpan="2" Fill="{StaticResource DimBrush}" IsHitTestVisible="False"
                   Visibility="{Binding IsCardVisible, Converter={StaticResource BoolToVis}}"
                   Opacity="{Binding CurrentCard.RemainingFraction, Converter={StaticResource FadeOut}, FallbackValue=1}" />

        <!-- ── Шторки «у костра» ── -->
        <views:CharacterSheet Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="16,60,16,0"
                              Visibility="{Binding IsStatsOpen, Converter={StaticResource BoolToVis}}" />
        <views:BossSheet Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="16,60,16,0"
                         Visibility="{Binding IsBossesOpen, Converter={StaticResource BoolToVis}}" />

        <!-- ── Состояние 2: карточка подбора предмета ── -->
        <views:ItemCardView Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding CurrentCard}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            Visibility="{Binding DataContext.IsCardVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
