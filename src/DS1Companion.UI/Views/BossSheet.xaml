<UserControl x:Class="DS1Companion.UI.Views.BossSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS1Companion.Core.Presentation;assembly=DS1Companion.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="SheetChrome.xaml" />
    </UserControl.Resources>
    <Border Style="{StaticResource SheetBorder}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding CloseSheetCommand}" ToolTip="Закрыть (Esc)">
                    <Path Data="{StaticResource Ui.Close}" Width="11" Height="11" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <StackPanel>
                    <Border Width="40" Height="4" CornerRadius="2" Background="{DynamicResource LineBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Style="{StaticResource Caption}" Text="СТАТИСТИКА ПО БОССАМ" />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,4,0,0"
                               Text="Тихий фоновый учёт попыток и времени. Во время боя ничего не показывается." />
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BossStats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BossStatRowViewModel}">
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource Ui.Crown}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource TextFaintBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Defeated}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource GoldBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="15" Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextBase}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAttempts}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Body}" FontSize="11" Text="{Binding StatusText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TextBase}" FontSize="13" HorizontalAlignment="Right">
                                            <Run Text="Попыток: " Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding Attempts, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Body}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right" Text="{Binding TimeText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
