<UserControl x:Class="DS1Companion.UI.Views.ItemCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DS1Companion.Core.Presentation;assembly=DS1Companion.Core"
             xmlns:ctl="clr-namespace:DS1Companion.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ItemCardViewModel}"
             MaxWidth="560" MinWidth="420"
             Opacity="{Binding RemainingFraction, Converter={StaticResource FadeOut}}"
             MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
    </UserControl.RenderTransform>
    <UserControl.RenderTransformOrigin>0.5,0.5</UserControl.RenderTransformOrigin>

    <Grid>
        <!-- Мягкое свечение по цвету редкости -->
        <Border CornerRadius="8" Background="{DynamicResource PanelBrush}">
            <Border.Effect>
                <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="46" Opacity="0.55"
                                  Color="{Binding RarityColor, Converter={StaticResource HexToColor}}" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{Binding RarityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.55}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#161920" Offset="0" />
                    <GradientStop Color="#0C0D11" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Филигрань по углам -->
                <Path Data="{StaticResource Ui.Filigree}" Width="40" Height="40" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Fill="{Binding RarityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.8}" />
                <Path Data="{StaticResource Ui.Filigree}" Width="40" Height="40" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Fill="{Binding RarityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.8}" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform ScaleX="-1" /></Path.RenderTransform>
                </Path>
                <Path Data="{StaticResource Ui.Filigree}" Width="40" Height="40" Margin="8,8,8,14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      Fill="{Binding RarityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.8}" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform ScaleY="-1" /></Path.RenderTransform>
                </Path>
                <Path Data="{StaticResource Ui.Filigree}" Width="40" Height="40" Margin="8,8,8,14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Fill="{Binding RarityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.8}" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Path.RenderTransform>
                </Path>

                <!-- Закрыть -->
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                        ToolTip="Закрыть (Esc)"
                        Command="{Binding DataContext.DismissCardCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Path Data="{StaticResource Ui.Close}" Width="10" Height="10" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>

                <StackPanel Margin="44,40,44,30">
                    <!-- Лента редкости -->
                    <Border HorizontalAlignment="Center" Padding="22,5" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0" Color="{Binding RarityColor, Converter={StaticResource HexToColor}, ConverterParameter=0}" />
                                <GradientStop Offset="0.2" Color="{Binding RarityColor, Converter={StaticResource HexToColor}, ConverterParameter=0.9}" />
                                <GradientStop Offset="0.8" Color="{Binding RarityColor, Converter={StaticResource HexToColor}, ConverterParameter=0.9}" />
                                <GradientStop Offset="1" Color="{Binding RarityColor, Converter={StaticResource HexToColor}, ConverterParameter=0}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding RarityLabel}" FontFamily="{DynamicResource SerifFont}" FontSize="13" FontWeight="Bold"
                                   Foreground="#0B0C10" />
                    </Border>
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="{Binding CategoryLabel}" />

                    <!-- Иконка с ореолом -->
                    <Grid Width="150" Height="150" Margin="0,18,0,10" HorizontalAlignment="Center">
                        <Ellipse>
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="{Binding RarityColor, Converter={StaticResource HexToColor}, ConverterParameter=0.38}" />
                                    <GradientStop Offset="1" Color="{Binding RarityColor, Converter={StaticResource HexToColor}, ConverterParameter=0}" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <ctl:ItemIcon Width="96" Height="96" Source="{Binding Icon}"
                                      GlyphBrush="{Binding RarityColor, Converter={StaticResource HexToBrush}}" />
                    </Grid>

                    <TextBlock Style="{StaticResource SerifTitle}" FontSize="30" TextAlignment="Center" HorizontalAlignment="Center"
                               Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource TextBase}" FontStyle="Italic" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="{Binding NameEn, Mode=OneWay}" />
                        <Run Text="{Binding QuantityText, Mode=OneWay}" Foreground="{DynamicResource GoldBrush}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                               Foreground="{Binding RarityColor, Converter={StaticResource HexToBrush}}" Text="{Binding RarityReason}" />

                    <Grid Margin="0,20,0,18" HorizontalAlignment="Center" Width="220">
                        <Rectangle Height="1" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center" />
                        <Path Data="{StaticResource Ui.Diamond}" Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Center"
                              Fill="{Binding RarityColor, Converter={StaticResource HexToBrush}}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Body}" FontSize="16" LineHeight="25" Foreground="{DynamicResource TextBrush}"
                               TextAlignment="Center" Text="{Binding Summary}" />

                    <Border HorizontalAlignment="Center" Margin="0,22,0,0" Padding="16,6" CornerRadius="14" BorderThickness="1"
                            BorderBrush="{DynamicResource GoldBrush}" Background="#14C8A96A">
                        <TextBlock Text="{Binding KeepTag}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" />
                    </Border>

                    <TextBlock Style="{StaticResource Body}" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"
                               Foreground="{StaticResource TextFaintBrush}" Text="{Binding DataContext.PendingCardsText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Style="{StaticResource Body}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{StaticResource TextFaintBrush}" Text="Наведите курсор, чтобы задержать карточку" />
                </StackPanel>

                <!-- Обратный отсчёт 10 секунд -->
                <Border Height="3" VerticalAlignment="Bottom" Background="#14FFFFFF">
                    <Border Background="{Binding RarityColor, Converter={StaticResource HexToBrush}}" RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding RemainingFraction}" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
