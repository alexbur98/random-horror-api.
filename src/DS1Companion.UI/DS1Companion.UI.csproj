<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DS1Companion.UI</RootNamespace>
    <AssemblyName>DS1Companion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Product>Souls Companion</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DS1Companion.Core\DS1Companion.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- База знаний и оффсеты лежат в корне решения (Data/) и копируются рядом с exe. -->
    <None Include="..\..\Data\**\*.json" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Оригинальные иконки (не входят в репозиторий) — Assets/Icons/{item_id}.png. -->
    <None Include="Assets\Icons\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Icons\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
