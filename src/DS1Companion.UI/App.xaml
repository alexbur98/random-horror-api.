<Application x:Class="DS1Companion.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DS1Companion.UI.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
                <ResourceDictionary Source="Themes/Glyphs.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:HexToColorConverter x:Key="HexToColor" />
            <conv:FadeOutConverter x:Key="FadeOut" />
            <conv:RarityLabelConverter x:Key="RarityLabel" />
            <conv:WaitingHintVisibilityConverter x:Key="WaitingHintVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
